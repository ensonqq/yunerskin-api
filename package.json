{
  "name": "yunerksin-api",
  "version": "1.0.0",
  "description": "yunerksin restful api, node js",
  "bin": "bin/createNodejsApp.js",
  "main": "src/index.js",
  "repository": "https://github.com/hagopj13/node-express-boilerplate.git",
  "author": "Enson Li <ensonq@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production pm2 start ./src/index.js --watch 'src' --ignore-watch 'node_modules upload' --name yunerksin-api",
    "dev": "cross-env NODE_ENV=development pm2 start ./src/index.js --watch 'src' --ignore-watch 'node_modules upload' --name dev-yunerksin-api",
    "test": "jest -i --colors --verbose --detectOpenHandles",
    "test:watch": "jest -i --watchAll",
    "coverage": "jest -i --coverage",
    "coverage:coveralls": "jest -i --coverage --coverageReporters=text-lcov | coveralls",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check **/*.js",
    "prettier:fix": "prettier --write **/*.js",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:test": "docker-compose -f docker-compose.yml -f docker-compose.test.yml up",
    "prepare": "husky install"
  },
  "keywords": [
    "node",
    "node.js",
    "boilerplate",
    "generator",
    "express",
    "rest",
    "api",
    "mongodb",
    "mongoose",
    "es6",
    "es7",
    "es8",
    "es9",
    "jest",
    "travis",
    "docker",
    "passport",
    "joi",
    "eslint",
    "prettier"
  ],
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cron": "^2.1.0",
    "cross-env": "^7.0.0",
    "crypto": "^1.0.1",
    "crypto-js": "^4.1.1",
    "csv-parser": "^3.0.0",
    "csvtojson": "^2.0.10",
    "date-holidays": "^3.16.11",
    "deep-parse-json": "^1.0.2",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-mongo-sanitize": "^2.0.0",
    "express-rate-limit": "^5.0.0",
    "facebook-nodejs-business-sdk": "^15.0.0",
    "fs-extra": "^10.0.0",
    "helmet": "^4.1.0",
    "http-status": "^1.4.0",
    "install": "^0.13.0",
    "joi": "^17.3.0",
    "json2csv": "^5.0.7",
    "jsonexport": "^3.2.0",
    "jsonwebtoken": "^8.5.1",
    "moment": "^2.24.0",
    "moment-timezone": "^0.5.39",
    "mongoose": "^5.7.7",
    "mongoose-aggregate-paginate-v2": "^1.0.6",
    "morgan": "^1.9.1",
    "multer": "^1.4.2",
    "nodemailer": "^6.3.1",
    "npm": "^9.9.0",
    "passport": "^0.4.0",
    "passport-jwt": "^4.0.0",
    "paypal-rest-sdk": "^1.8.1",
    "pm2": "^5.1.0",
    "randomstring": "^1.2.3",
    "request": "^2.88.2",
    "sharp": "^0.28.2",
    "stream-json": "^1.8.0",
    "stripe": "^10.15.0",
    "swagger-jsdoc": "^6.0.8",
    "swagger-ui-express": "^4.1.6",
    "underscore": "^1.13.4",
    "unique-filename": "^1.1.1",
    "validator": "^13.0.0",
    "winston": "^3.2.1",
    "xml2json": "^0.12.0",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "body-parser": "^1.20.1",
    "coveralls": "^3.0.7",
    "eslint": "^7.0.0",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-jest": "^24.0.1",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-security": "^1.4.0",
    "faker": "^5.1.0",
    "husky": "^7.0.0",
    "jest": "^26.0.1",
    "lint-staged": "^11.0.0",
    "lodash": "^4.17.21",
    "node-mocks-http": "^1.8.0",
    "nodemon": "^2.0.0",
    "prettier": "^2.0.5",
    "supertest": "^6.0.1"
  }
}
